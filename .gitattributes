* text=auto

# Scripts and units are copied to the Linux servers; a CR breaks shebangs and systemd paths.
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.ico binary

# The pinned api spec is compared byte for byte with the api repo's copy.
specs/** -text
*.json text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
nginx.conf text eol=lf
Dockerfile text eol=lf
